# Copy this file to .env.local and fill in your own value.
# .env.local is gitignored -- never commit real keys.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# That's it -- market data comes from a built-in simulated feed
# (lib/mock-market.ts), so no Deriv account, app_id, or network access to
# Deriv is required to run this. lib/deriv-client.ts is a complete, tested
# integration with Deriv's real public WebSocket API if you want to swap in
# live data later -- see the README.
